[Unit]
Description=FlightPulse API
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/flightpulse-api
# Refresh the saved Databricks results hourly (see database/databricks.py).
Environment=FLIGHTPULSE_REFRESH=on
ExecStart=/home/ubuntu/flightpulse-api/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2 --root-path /api
Restart=always

[Install]
WantedBy=multi-user.target
